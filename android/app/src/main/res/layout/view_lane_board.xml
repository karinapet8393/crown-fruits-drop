<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/lane_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <View
            android:id="@+id/lane_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/deco_lane_frame" />

        <View
            android:id="@+id/lane_gap_one"
            android:layout_width="@dimen/lane_gap"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/lane_center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/deco_lane_frame" />

        <View
            android:id="@+id/lane_gap_two"
            android:layout_width="@dimen/lane_gap"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/lane_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/deco_lane_frame" />
    </LinearLayout>

    <View
        android:id="@+id/board_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/red" />
</merge>
