<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ImageView
        android:id="@+id/result_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/result_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_scrim_result"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/result_glow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0"
        android:background="@drawable/bg_win_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/result_crown"
        app:layout_constraintBottom_toBottomOf="@id/result_dishes" />

    <ImageView
        android:id="@+id/result_crown"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/status_bar_pad"
        android:contentDescription="@string/desc_crown"
        android:src="@drawable/ic_crown_big"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/result_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_lg"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.App.Headline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_crown" />

    <LinearLayout
        android:id="@+id/result_dishes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_title">

        <ImageView
            android:id="@+id/result_dish_one"
            android:layout_width="@dimen/sprite_dish"
            android:layout_height="@dimen/sprite_dish"
            android:layout_marginEnd="@dimen/space_xs"
            android:contentDescription="@string/desc_dish_pending"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/result_dish_two"
            android:layout_width="@dimen/sprite_dish"
            android:layout_height="@dimen/sprite_dish"
            android:layout_marginEnd="@dimen/space_xs"
            android:contentDescription="@string/desc_dish_pending"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/result_dish_three"
            android:layout_width="@dimen/sprite_dish"
            android:layout_height="@dimen/sprite_dish"
            android:layout_marginEnd="@dimen/space_xs"
            android:contentDescription="@string/desc_dish_pending"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/result_dish_four"
            android:layout_width="@dimen/sprite_dish"
            android:layout_height="@dimen/sprite_dish"
            android:contentDescription="@string/desc_dish_pending"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_stats_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_dishes">

        <com.WqNzVmK.rJpLtF.core.ui.StatCardView
            android:id="@+id/result_stat_recipes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xxs"
            android:layout_weight="1"
            app:statAccent="@color/gold"
            app:statLabel="@string/stat_recipes_label" />

        <com.WqNzVmK.rJpLtF.core.ui.StatCardView
            android:id="@+id/result_stat_accuracy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:layout_marginEnd="@dimen/space_xxs"
            android:layout_weight="1"
            app:statAccent="@color/green"
            app:statLabel="@string/stat_accuracy_label" />

        <com.WqNzVmK.rJpLtF.core.ui.StatCardView
            android:id="@+id/result_stat_best"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:layout_weight="1"
            app:statAccent="@color/blue"
            app:statLabel="@string/stat_best_label" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_marble_sheet"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/result_divider"
            android:layout_width="@dimen/divider_width"
            android:layout_height="@dimen/divider_height"
            android:importantForAccessibility="no"
            android:src="@drawable/deco_crown_divider" />

        <TextView
            android:id="@+id/result_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <FrameLayout
            android:id="@+id/result_cta_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <ImageView
                android:id="@+id/result_cta_plate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cta_plate_height"
                android:layout_gravity="center"
                android:alpha="0.92"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/result_play_again"
                style="@style/Widget.App.Button.Primary"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_primary_height"
                android:text="@string/cta_play_again"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_button"
                app:iconTint="@color/bg_base" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/result_menu"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_secondary_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/cta_menu" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
